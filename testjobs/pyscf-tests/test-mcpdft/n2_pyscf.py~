def read_gammcor_mx(filename):
    from scipy.io import FortranFile
    f = FortranFile(filename, 'r')
    nbasis = f.read_ints(dtype=np.int32)[0]
    mat = f.read_reals(dtype=np.float64)
    f.close()
    mat = mat.reshape(nbasis, nbasis)
    # for i in range(nbasis):
    #     for j in range(nbasis):
    #         print(f'xmum{i+1:5d}{j+1:5d}{xmumat[i,j]:20.15f}{xmumat[j,i]:20.15f}')

    return mat


